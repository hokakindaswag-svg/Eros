[
  {
    "name": "theme_info",
    "theme_name": "EROS PARIS",
    "theme_version": "1.0.0",
    "theme_author": "EROS PARIS",
    "theme_documentation_url": "https://shopify.dev",
    "theme_support_url": "https://shopify.dev"
  },
  {
    "name": "Identité",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Nom de la marque (wordmark)",
        "default": "EROS PARIS"
      },
      {
        "type": "select",
        "id": "logo_source",
        "label": "Affichage du logo",
        "options": [
          {
            "value": "theme",
            "label": "Logo EROS fourni avec le thème"
          },
          {
            "value": "custom",
            "label": "Image téléversée (réglage ci-dessous)"
          },
          {
            "value": "text",
            "label": "Texte (wordmark)"
          }
        ],
        "default": "theme"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo personnalisé",
        "info": "Utilisé si « Image téléversée » est sélectionné."
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 14,
        "max": 70,
        "step": 2,
        "unit": "px",
        "label": "Hauteur du logo",
        "default": 40
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image de partage (réseaux sociaux)"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police d'interface",
        "default": "assistant_n4",
        "info": "Sans-serif contemporaine recommandée."
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "archivo_n7",
        "info": "Utilisée en capitales sur les grands titres."
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Graisse des titres",
        "options": [
          {
            "value": "600",
            "label": "Semi-bold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra-bold"
          },
          {
            "value": "900",
            "label": "Black"
          }
        ],
        "default": "800"
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -5,
        "max": 10,
        "step": 1,
        "unit": "%",
        "label": "Interlettrage des titres",
        "default": -2
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1900,
        "step": 20,
        "unit": "px",
        "label": "Largeur maximale du site",
        "default": 1680
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Activer les animations d'apparition",
        "default": true
      }
    ]
  },
  {
    "name": "Produits",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Format des visuels produit",
        "options": [
          {
            "value": "1/1",
            "label": "Carré (recommandé)"
          },
          {
            "value": "4/5",
            "label": "Portrait doux"
          },
          {
            "value": "3/4",
            "label": "Portrait"
          },
          {
            "value": "4/3",
            "label": "Paysage"
          }
        ],
        "default": "1/1",
        "info": "Le carré convient à la quasi-totalité des packshots. Les bijoux ne sont jamais recadrés : ils s'inscrivent en entier dans le cadre."
      },
      {
        "type": "select",
        "id": "card_surface",
        "label": "Fond des visuels produit",
        "info": "À accorder au fond de vos photos. Packshots sur fond blanc : choisissez Blanc. Bijoux détourés ou photographiés sur fond sombre : choisissez Noir.",
        "options": [
          {
            "value": "light",
            "label": "Blanc"
          },
          {
            "value": "soft",
            "label": "Gris très clair"
          },
          {
            "value": "dark",
            "label": "Noir profond"
          }
        ],
        "default": "light"
      },
      {
        "type": "range",
        "id": "card_padding",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "%",
        "label": "Air autour du bijou",
        "info": "Empêche la pièce de toucher les bords du cadre.",
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Changer d'image au survol",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Ajout rapide au panier sur les cartes produit",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Afficher le vendeur sur la fiche produit",
        "default": false
      },
      {
        "type": "text",
        "id": "badge_new_tag",
        "label": "Tag produit affichant le badge NOUVEAUTÉ",
        "default": "nouveaute",
        "info": "Les produits portant ce tag affichent un badge."
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          {
            "value": "drawer",
            "label": "Panneau latéral"
          },
          {
            "value": "page",
            "label": "Page panier"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "richtext",
        "id": "cart_note",
        "label": "Mention sous le bouton de commande",
        "default": "<p>Livraison gratuite. Taxes incluses.</p>"
      }
    ]
  },
  {
    "name": "LA PROMESSE",
    "settings": [
      {
        "type": "paragraph",
        "content": "Concept signature EROS PARIS. Affiché sur les fiches produit et dans la navigation."
      },
      {
        "type": "checkbox",
        "id": "promise_on_product",
        "label": "Afficher l'encart LA PROMESSE sur les fiches produit",
        "default": true
      },
      {
        "type": "text",
        "id": "promise_title",
        "label": "Titre de l'encart",
        "default": "LA PROMESSE"
      },
      {
        "type": "richtext",
        "id": "promise_text",
        "label": "Texte de l'encart",
        "default": "<p>Ce bijou peut être acheté comme une promesse faite à une personne précise.</p>"
      },
      {
        "type": "url",
        "id": "promise_link",
        "label": "Lien vers la page LA PROMESSE"
      },
      {
        "type": "text",
        "id": "promise_link_label",
        "label": "Libellé du lien",
        "default": "EN SAVOIR PLUS"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_handle",
        "label": "Pseudo affiché",
        "default": "@erosparis"
      }
    ]
  }
]