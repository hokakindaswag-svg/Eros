{%- comment -%}
  EROS PARIS — Mur social éditorial (pas une grille Instagram basique).
  Chaque bloc peut être une image ou une vidéo, avec un lien.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="t-eyebrow reveal" style="margin-bottom:10px">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title reveal">{{ s.title }}</h2>
      </div>
      {%- if s.link_url != blank -%}
        <a href="{{ s.link_url }}" target="_blank" rel="noopener" class="section-head__link reveal">
          {{ s.link_label | default: settings.social_handle }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="ugc{% if s.full_width == false %} page-width{% endif %}">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- assign url = b.url -%}
      {%- if b.product != blank -%}{%- assign url = b.product.url -%}{%- endif -%}
      <{% if url != blank %}a href="{{ url }}"{% else %}div{% endif %}
        class="ugc__cell ugc__cell--{{ b.size }} reveal"
        style="--reveal-delay:{{ forloop.index0 | times: 45 }}ms"
        {{ block.shopify_attributes }}
      >
        {%- if b.video != blank -%}
          <video autoplay muted loop playsinline data-autoplay {% if b.image %}poster="{{ b.image | image_url: width: 800 }}"{% endif %}>
            <source src="{{ b.video }}" type="video/mp4">
          </video>
        {%- elsif b.image != blank -%}
          <img
            src="{{ b.image | image_url: width: 1000 }}"
            srcset="{{ b.image | image_url: width: 500 }} 500w, {{ b.image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 750px) 25vw, 50vw"
            alt="{{ b.image.alt | escape }}"
            loading="lazy" decoding="async"
            width="{{ b.image.width }}" height="{{ b.image.height }}"
          >
        {%- else -%}
          <div class="media__placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
        {%- endif -%}

        {%- if b.caption != blank or b.product != blank -%}
          <div class="ugc__meta">
            <span class="ugc__handle">{{ b.caption | default: b.product.title }}</span>
            {%- if b.product != blank -%}
              <span class="ugc__handle">{{ b.product.price | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </{% if url != blank %}a{% else %}div{% endif %}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Social / UGC",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "COMMUNAUTÉ" },
    { "type": "text", "id": "title", "label": "Titre", "default": "PORTÉ PAR VOUS" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "@EROSPARIS" },
    { "type": "url", "id": "link_url", "label": "Lien (Instagram, TikTok…)" },
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": true }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Contenu",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "video", "label": "Vidéo (MP4)" },
        {
          "type": "select", "id": "size", "label": "Format",
          "options": [
            { "value": "a", "label": "Portrait" },
            { "value": "b", "label": "Carré" },
            { "value": "tall", "label": "Grand portrait (2 lignes)" },
            { "value": "wide", "label": "Large (2 colonnes)" }
          ],
          "default": "a"
        },
        { "type": "text", "id": "caption", "label": "Légende courte" },
        { "type": "product", "id": "product", "label": "Produit associé" },
        { "type": "url", "id": "url", "label": "Lien personnalisé" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social / UGC",
      "blocks": [
        { "type": "post", "settings": { "size": "tall" } },
        { "type": "post", "settings": { "size": "b" } },
        { "type": "post", "settings": { "size": "b" } },
        { "type": "post", "settings": { "size": "a" } },
        { "type": "post", "settings": { "size": "wide" } },
        { "type": "post", "settings": { "size": "a" } }
      ]
    }
  ]
}
{% endschema %}
