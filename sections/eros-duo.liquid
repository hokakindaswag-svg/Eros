{%- comment -%}
  EROS PARIS — DUO
  Une OFFRE : deux bijoux achetés ensemble, un pour soi et un pour
  la personne de son choix. Les deux pièces n'ont pas à être identiques.
  Ce n'est pas une collection « bijoux de couple ».
{%- endcomment -%}

{%- assign s = section.settings -%}

<section class="section" style="--section-pt:0;--section-pb:0;--section-pt-d:0;--section-pb-d:0">
  <div class="split{% if s.reverse %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1600 }}"
          srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ s.image.alt | escape | default: s.title }}"
          loading="lazy"
          width="{{ s.image.width }}" height="{{ s.image.height }}"
        >
      {%- else -%}
        <div class="media__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if s.image_overlay > 0 -%}
        <span style="position:absolute;inset:0;background:rgba(0,0,0,{{ s.image_overlay | divided_by: 100.0 }})"></span>
      {%- endif -%}
    </div>

    <div class="split__body">
      {%- if s.eyebrow != blank -%}<p class="t-eyebrow reveal">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="split__title reveal" style="margin-top:14px;--reveal-delay:50ms">{{ s.title }}</h2>
      {%- if s.lede != blank -%}<p class="split__lede reveal" style="--reveal-delay:90ms">{{ s.lede }}</p>{%- endif -%}
      {%- if s.text != blank -%}<div class="split__text t-body rte reveal" style="--reveal-delay:120ms">{{ s.text }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="steps reveal" style="--reveal-delay:140ms">
          {%- for block in section.blocks -%}
            <div class="step" {{ block.shopify_attributes }}>
              <span class="step__n">0{{ forloop.index }}</span>
              <div>
                <p class="step__t">{{ block.settings.title }}</p>
                {%- if block.settings.text != blank -%}
                  <p class="step__d">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Composition éditoriale : les bijoux sur une rangée, leurs légendes
        sur la suivante. Le signe se centre ainsi exactement sur les pièces.
      {%- endcomment -%}
      {%- assign pa = s.product_a -%}
      {%- assign pb = s.product_b -%}
      {%- assign has_pair = false -%}
      {%- if pa != blank and pb != blank -%}{%- assign has_pair = true -%}{%- endif -%}

      {%- if has_pair -%}
        <div class="duo-compo" style="--media-pad:{{ settings.card_padding | default: 8 }}%">
          {% render 'duo-media', product: pa, pos: 'a', delay: 160 %}

          {%- if s.show_chip -%}
            <span class="duo-join reveal" aria-hidden="true" style="--reveal-delay:240ms">
              <span class="duo-join__line"></span>
              <span class="duo-join__mark">+</span>
              <span class="duo-join__line"></span>
            </span>
          {%- else -%}
            <span class="duo-join" aria-hidden="true"></span>
          {%- endif -%}

          {% render 'duo-media', product: pb, pos: 'b', delay: 320 %}

          {% render 'duo-caption', product: pa, role: s.label_a, pos: 'a', delay: 200 %}
          <span class="duo-spacer" aria-hidden="true"></span>
          {% render 'duo-caption', product: pb, role: s.label_b, pos: 'b', delay: 360 %}
        </div>

      {%- elsif pa != blank or pb != blank -%}
        {%- assign solo = pa | default: pb -%}
        {%- assign solo_role = s.label_a | default: s.label_b -%}
        <div class="duo-compo duo-compo--solo" style="--media-pad:{{ settings.card_padding | default: 8 }}%">
          {% render 'duo-media', product: solo, pos: 'a', delay: 160 %}
          {% render 'duo-caption', product: solo, role: solo_role, pos: 'a', delay: 200 %}
        </div>
      {%- endif -%}

      {%- if s.cta_label != blank -%}
        <div class="reveal" style="--reveal-delay:340ms">
          <a href="{{ s.cta_url | default: routes.all_products_collection_url }}" class="duo-cta">
            <span class="duo-cta__label">{{ s.cta_label }}</span>
            <span class="duo-cta__arrow">{% render 'icon', name: 'arrow' %}</span>
          </a>
        </div>
      {%- endif -%}

      {%- if s.note != blank -%}<p class="split__note reveal">{{ s.note }}</p>{%- endif -%}
    </div>
  </div>

  {%- comment -%} Collection DUO sous la section éditoriale {%- endcomment -%}
  {%- if s.collection != blank and s.show_collection -%}
    <div class="page-width" style="padding-block:52px">
      <div class="section-head">
        <h3 class="section-title reveal" style="font-size:clamp(20px,4.5vw,38px)">{{ s.collection_title | default: s.collection.title }}</h3>
        <a href="{{ s.collection.url }}" class="section-head__link reveal">TOUT VOIR</a>
      </div>
      <div class="product-grid" style="--cols-m:2;--cols-d:4">
        {%- for product in s.collection.products limit: s.collection_count -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "DUO",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Assombrissement de l'image", "default": 10 },
    { "type": "checkbox", "id": "reverse", "label": "Inverser image / texte", "default": true },
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'OFFRE DUO" },
    { "type": "text", "id": "title", "label": "Titre", "default": "POUR VOUS DEUX" },
    { "type": "text", "id": "lede", "label": "Phrase d'accroche", "default": "Deux bijoux : un pour vous, un pour la personne de votre choix." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "note", "label": "Mention en bas" },
    { "type": "header", "content": "La paire" },
    { "type": "product", "id": "product_a", "label": "Pièce A" },
    { "type": "text", "id": "label_a", "label": "Étiquette A", "default": "L'UNE POUR VOUS" },
    { "type": "product", "id": "product_b", "label": "Pièce B" },
    { "type": "text", "id": "label_b", "label": "Étiquette B", "default": "L'AUTRE POUR QUI VOUS VOULEZ" },
    { "type": "checkbox", "id": "show_chip", "label": "Afficher le symbole entre les deux pièces", "default": true },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "COMPOSER MON DUO" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" },
    { "type": "header", "content": "Collection DUO" },
    { "type": "checkbox", "id": "show_collection", "label": "Afficher une grille sous la section", "default": false },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "collection_title", "label": "Titre de la grille" },
    { "type": "range", "id": "collection_count", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 8 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DUO",
      "blocks": [
        { "type": "step", "settings": { "title": "CHOISISSEZ DEUX PIÈCES", "text": "Dans la sélection DUO. Identiques ou non, c'est vous qui voyez." } },
        { "type": "step", "settings": { "title": "UNE POUR VOUS", "text": "Celle que vous garderez." } },
        { "type": "step", "settings": { "title": "UNE POUR QUI VOUS VOULEZ", "text": "Partenaire, ami, frère, sœur. La personne de votre choix." } }
      ]
    }
  ]
}
{% endschema %}
