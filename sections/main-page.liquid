<section class="page-hero">
  <div class="page-width page-width--narrow">
    <h1 class="page-hero__title">{{ page.title }}</h1>
  </div>
</section>
<section class="page-body">
  <div class="page-width page-width--narrow rte">
    {{ page.content }}
  </div>
</section>
{% schema %}
{ "name": "Page", "tag": "section" }
{% endschema %}
