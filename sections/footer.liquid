<footer class="footer">
  <div class="page-width">
    <div class="footer__top">

      <div>
        <p class="footer__brand">{% render 'brand-logo', height: 40 %}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tag">{{ section.settings.tagline }}</p>
        {%- endif -%}
        <div class="footer__socials">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.title }}</p>
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'links' -%}
            <div {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.title }}</p>
              <ul class="footer__links">
                {%- for i in (1..6) -%}
                  {%- assign label_key = 'label_' | append: i -%}
                  {%- assign url_key = 'url_' | append: i -%}
                  {%- assign label = block.settings[label_key] -%}
                  {%- if label != blank -%}
                    <li><a href="{{ block.settings[url_key] | default: '#' }}">{{ label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__news" {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.title }}</p>
              <p class="t-body" style="font-size:var(--fs-xs)">{{ block.settings.text }}</p>
              {% form 'customer' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-success">{{ 'general.newsletter_form.success' | t }}</p>
                {%- else -%}
                  <label class="visually-hidden" for="footer-news">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
                  <input
                    id="footer-news"
                    class="input"
                    type="email"
                    name="contact[email]"
                    required
                    autocomplete="email"
                    placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                  >
                  <button type="submit" class="btn btn--primary btn--full" style="margin-top:8px">
                    {{ 'general.newsletter_form.submit' | t }}
                  </button>
                  {%- if form.errors -%}
                    <p class="form-error">{{ form.errors.messages['email'] }}</p>
                  {%- endif -%}
                {%- endif -%}
              {% endform %}
            </div>
        {%- endcase -%}
      {%- endfor -%}

    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
        <span class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      <div class="footer__wordmark" aria-hidden="true">
        {%- if settings.logo_source == 'text' -%}
          {{ settings.brand_name | default: shop.name }}
        {%- else -%}
          {% render 'brand-logo', height: 200, class: 'footer__wordmark-img' %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Accroche", "default": "Bijoux EROS PARIS. Portés le jour, remarqués la nuit." },
    { "type": "link_list", "id": "legal_menu", "label": "Menu légal", "info": "Mentions légales, CGV, confidentialité…" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "checkbox", "id": "show_wordmark", "label": "Afficher le grand wordmark", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne (menu Shopify)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "BOUTIQUE" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "links",
      "name": "Colonne (liens manuels)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "AIDE" },
        { "type": "text", "id": "label_1", "label": "Lien 1" },
        { "type": "url", "id": "url_1", "label": "URL 1" },
        { "type": "text", "id": "label_2", "label": "Lien 2" },
        { "type": "url", "id": "url_2", "label": "URL 2" },
        { "type": "text", "id": "label_3", "label": "Lien 3" },
        { "type": "url", "id": "url_3", "label": "URL 3" },
        { "type": "text", "id": "label_4", "label": "Lien 4" },
        { "type": "url", "id": "url_4", "label": "URL 4" },
        { "type": "text", "id": "label_5", "label": "Lien 5" },
        { "type": "url", "id": "url_5", "label": "URL 5" },
        { "type": "text", "id": "label_6", "label": "Lien 6" },
        { "type": "url", "id": "url_6", "label": "URL 6" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "NEWSLETTER" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Nouveautés et accès prioritaires." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "BOUTIQUE" } },
      {
        "type": "links",
        "settings": {
          "title": "AIDE",
          "label_1": "LIVRAISON",
          "label_2": "RETOURS",
          "label_3": "ENTRETIEN",
          "label_4": "FAQ",
          "label_5": "CONTACT"
        }
      },
      { "type": "newsletter", "settings": { "title": "NEWSLETTER" } }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
