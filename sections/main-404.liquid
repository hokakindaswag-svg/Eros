<section class="section" style="--section-pt:120px;--section-pb:120px">
  <div class="page-width" style="text-align:center">
    <h1 class="hero-title chrome-text">404</h1>
    <p class="t-eyebrow" style="margin-top:18px">{{ 'general.404.title' | t }}</p>
    <p class="t-body" style="margin-top:10px">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary btn--lg" style="margin-top:30px">{{ 'general.404.link' | t }}</a>
  </div>
</section>
{% schema %}
{ "name": "404", "tag": "section" }
{% endschema %}
