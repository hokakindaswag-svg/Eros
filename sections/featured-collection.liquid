{%- liquid
  assign s = section.settings
  assign coll = s.collection
  assign prods = coll.products
  assign count = s.count | default: 8
-%}

<section class="section" id="section-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="t-eyebrow reveal" style="margin-bottom:10px">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title reveal">{{ s.title | default: coll.title }}</h2>
      </div>
      {%- if s.show_view_all and coll != blank -%}
        <a href="{{ coll.url }}" class="section-head__link reveal">{{ s.view_all_label | default: 'TOUT VOIR' }}</a>
      {%- endif -%}
    </div>

    {%- if prods.size > 0 -%}
      {%- if s.layout == 'rail' -%}
        <div class="scroll-x product-rail">
          {%- for product in prods limit: count -%}
            {% render 'product-card', product: product, index: forloop.index0, ratio: s.ratio %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-grid" style="--cols-m:{{ s.cols_mobile }};--cols-t:3;--cols-d:{{ s.cols_desktop }}">
          {%- for product in prods limit: count -%}
            {% render 'product-card', product: product, index: forloop.index0, ratio: s.ratio %}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.show_cta and coll != blank -%}
        <div class="reveal" style="margin-top:34px;text-align:center">
          <a href="{{ coll.url }}" class="btn btn--ghost btn--lg">{{ s.cta_label | default: 'SHOPPER LA COLLECTION' }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="t-body">Sélectionnez une collection dans l'éditeur de thème.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produits en avant",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "BEST-SELLERS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 24, "step": 1, "label": "Nombre de produits", "default": 8 },
    {
      "type": "select", "id": "layout", "label": "Affichage",
      "options": [
        { "value": "grid", "label": "Grille" },
        { "value": "rail", "label": "Défilement horizontal" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "cols_mobile", "min": 1, "max": 2, "step": 1, "label": "Colonnes mobile", "default": 2 },
    { "type": "range", "id": "cols_desktop", "min": 2, "max": 6, "step": 1, "label": "Colonnes desktop", "default": 4 },
    {
      "type": "select", "id": "ratio", "label": "Format des images",
      "options": [
        { "value": "1/1", "label": "Carré" },
        { "value": "4/5", "label": "Portrait doux" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "2/3", "label": "Portrait haut" }
      ],
      "default": "3/4"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Lien « tout voir » en haut", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Libellé du lien", "default": "TOUT VOIR" },
    { "type": "checkbox", "id": "show_cta", "label": "Bouton sous la grille", "default": false },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "SHOPPER LA COLLECTION" }
  ],
  "presets": [{ "name": "Produits en avant" }]
}
{% endschema %}
