{%- comment -%}
  EROS PARIS — Guide des tailles (page dediee).
  Le contenu vit dans le snippet size-guide-body, partage avec le tiroir
  des fiches produit : une seule source, pas de divergence possible.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section class="section">
  <div class="page-width sg">
    <header class="sg__head">
      {%- if s.eyebrow != blank -%}<p class="t-eyebrow reveal">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="sg__title reveal" style="--reveal-delay:50ms">{{ s.title }}</h1>
      {%- if s.lede != blank -%}<p class="sg__lede reveal" style="--reveal-delay:90ms">{{ s.lede }}</p>{%- endif -%}
    </header>

    <nav class="sg__nav reveal" style="--reveal-delay:120ms" aria-label="{{ s.title }}">
      <a href="#bagues">BAGUES</a>
      <a href="#bracelets">BRACELETS</a>
      <a href="#colliers">CHAÎNES &amp; COLLIERS</a>
      <a href="#boucles">BOUCLES D'OREILLES</a>
    </nav>

    <div class="sg__body">
      {% render 'size-guide-body' %}
    </div>

    {%- if s.footnote != blank -%}
      <p class="sg__foot">{{ s.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Guide des tailles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "EROS PARIS" },
    { "type": "text", "id": "title", "label": "Titre", "default": "GUIDE DES TAILLES" },
    { "type": "text", "id": "lede", "label": "Phrase d'accroche", "default": "Toutes les mesures en centimètres. Le sélecteur de chaque fiche produit reprend la valeur d'origine." },
    {
      "type": "header",
      "content": "Tailles de bague"
    },
    {
      "type": "paragraph",
      "content": "Les correspondances de tailles de bague se modifient dans Réglages > Guide des tailles. Elles sont partagées avec le tiroir des fiches produit."
    },
    { "type": "text", "id": "footnote", "label": "Mention en bas", "default": "Une question sur une taille ? Écrivez-nous, nous vous répondons avant votre commande." }
  ],
  "presets": [{ "name": "Guide des tailles" }]
}
{% endschema %}
