<section class="section">
  <div class="page-width page-width--narrow">
    <h2 class="section-title reveal">{{ section.settings.title }}</h2>
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'contact.form.post_success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-error">{{ 'contact.form.error_heading' | t }} {{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="stack" style="margin-top:24px">
          <div class="field">
            <label class="visually-hidden" for="c-name">{{ 'contact.form.name' | t }}</label>
            <input class="input" id="c-name" type="text" name="contact[name]" placeholder="{{ 'contact.form.name' | t }}" required>
          </div>
          <div class="field">
            <label class="visually-hidden" for="c-email">{{ 'contact.form.email' | t }}</label>
            <input class="input" id="c-email" type="email" name="contact[email]" placeholder="{{ 'contact.form.email' | t }}" required>
          </div>
          <div class="field">
            <label class="visually-hidden" for="c-msg">{{ 'contact.form.message' | t }}</label>
            <textarea class="input" id="c-msg" name="contact[body]" rows="6" placeholder="{{ 'contact.form.message' | t }}" required></textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--lg">{{ 'contact.form.send' | t }}</button>
        </div>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "CONTACT" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
