{%- liquid
  assign s = section.settings
  assign align_map = 'flex-start'
  case s.align
    when 'center'
      assign align_map = 'center'
    when 'right'
      assign align_map = 'flex-end'
  endcase
-%}

<section
  class="campaign"
  style="--camp-h-m:{{ s.height_mobile }}svh;--camp-h-d:{{ s.height_desktop }}svh;--camp-align:{{ align_map }};--camp-text-align:{{ s.align }};--camp-justify:{{ s.vertical }}"
>
  <div class="campaign__media">
    {%- if s.video != blank -%}
      <video class="campaign__media--desktop" autoplay muted loop playsinline data-autoplay
        {% if s.image_desktop %}poster="{{ s.image_desktop | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ s.video }}" type="video/mp4">
      </video>
    {%- elsif s.image_desktop != blank -%}
      <img class="campaign__media--desktop"
        src="{{ s.image_desktop | image_url: width: 2400 }}"
        srcset="{{ s.image_desktop | image_url: width: 1400 }} 1400w, {{ s.image_desktop | image_url: width: 2400 }} 2400w"
        sizes="100vw" alt="{{ s.image_desktop.alt | escape }}" loading="lazy"
        width="{{ s.image_desktop.width }}" height="{{ s.image_desktop.height }}"
        style="--focal:{{ s.image_desktop.presentation.focal_point }}">
    {%- endif -%}

    {%- if s.image_mobile != blank -%}
      <img class="campaign__media--mobile"
        src="{{ s.image_mobile | image_url: width: 1200 }}"
        srcset="{{ s.image_mobile | image_url: width: 600 }} 600w, {{ s.image_mobile | image_url: width: 1200 }} 1200w"
        sizes="100vw" alt="{{ s.image_mobile.alt | escape }}" loading="lazy"
        width="{{ s.image_mobile.width }}" height="{{ s.image_mobile.height }}"
        style="--focal:{{ s.image_mobile.presentation.focal_point }}">
    {%- elsif s.image_desktop != blank -%}
      <img class="campaign__media--mobile" src="{{ s.image_desktop | image_url: width: 1200 }}" alt="{{ s.image_desktop.alt | escape }}" loading="lazy" width="{{ s.image_desktop.width }}" height="{{ s.image_desktop.height }}">
    {%- endif -%}

    {%- if s.image_desktop == blank and s.image_mobile == blank and s.video == blank -%}
      <div class="media__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>

  <div class="hero__overlay" style="background:linear-gradient(180deg,rgba(0,0,0,{{ s.overlay_top | divided_by: 100.0 }}),rgba(0,0,0,0) 42%,rgba(0,0,0,{{ s.overlay_bottom | divided_by: 100.0 }}))"></div>

  <div class="page-width campaign__inner">
    {%- if s.eyebrow != blank -%}<p class="t-eyebrow reveal" style="margin-bottom:14px">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.title != blank -%}
      <h2 class="campaign__title reveal{% if s.chrome_title %} chrome-text{% endif %}">{{ s.title }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}<p class="campaign__text reveal">{{ s.text }}</p>{%- endif -%}
    {%- if s.cta_label != blank -%}
      <div class="campaign__ctas reveal">
        <a href="{{ s.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">{{ s.cta_label }}</a>
        {%- if s.cta2_label != blank -%}
          <a href="{{ s.cta2_url }}" class="btn btn--ghost btn--lg">{{ s.cta2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Pastilles produit posées sur le visuel {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- assign p = block.settings.product -%}
    {%- if p != blank -%}
      <a class="hotspot surface surface--{{ settings.card_surface | default: 'light' }}"
        href="{{ p.url }}"
        style="top:{{ block.settings.top }}%;left:{{ block.settings.left }}%"
        {{ block.shopify_attributes }}>
        {%- if p.featured_media -%}
          <img src="{{ p.featured_media | image_url: width: 120 }}" alt="" loading="lazy" width="44" height="56">
        {%- endif -%}
        <span>
          <span class="hotspot__t">{{ p.title }}</span>
          <span class="hotspot__p">{{ p.price | money }}</span>
        </span>
      </a>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Campagne lifestyle",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Image desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile" },
    { "type": "url", "id": "video", "label": "Vidéo (MP4)" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "LA NUIT VOUS VA BIEN" },
    { "type": "checkbox", "id": "chrome_title", "label": "Titre effet chrome", "default": true },
    { "type": "text", "id": "text", "label": "Texte court" },
    { "type": "text", "id": "cta_label", "label": "Bouton 1", "default": "SHOPPER LA COLLECTION" },
    { "type": "url", "id": "cta_url", "label": "Lien bouton 1" },
    { "type": "text", "id": "cta2_label", "label": "Bouton 2" },
    { "type": "url", "id": "cta2_url", "label": "Lien bouton 2" },
    { "type": "header", "content": "Mise en page" },
    {
      "type": "select", "id": "align", "label": "Alignement",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "select", "id": "vertical", "label": "Position verticale",
      "options": [
        { "value": "flex-start", "label": "Haut" },
        { "value": "center", "label": "Milieu" },
        { "value": "flex-end", "label": "Bas" }
      ],
      "default": "flex-end"
    },
    { "type": "range", "id": "height_mobile", "min": 50, "max": 100, "step": 2, "unit": "%", "label": "Hauteur mobile", "default": 74 },
    { "type": "range", "id": "height_desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "label": "Hauteur desktop", "default": 90 },
    { "type": "range", "id": "overlay_top", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Assombrissement haut", "default": 30 },
    { "type": "range", "id": "overlay_bottom", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Assombrissement bas", "default": 65 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Pastille produit",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "range", "id": "top", "min": 5, "max": 90, "step": 1, "unit": "%", "label": "Position verticale", "default": 40 },
        { "type": "range", "id": "left", "min": 2, "max": 85, "step": 1, "unit": "%", "label": "Position horizontale", "default": 60 }
      ]
    }
  ],
  "presets": [{ "name": "Campagne lifestyle" }]
}
{% endschema %}
