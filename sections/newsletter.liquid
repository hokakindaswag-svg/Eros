<section class="section" style="background:{{ section.settings.background }}">
  <div class="page-width" style="max-width:760px;text-align:center">
    {%- if section.settings.eyebrow != blank -%}
      <p class="t-eyebrow reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="section-title reveal" style="margin-top:12px">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="t-body reveal" style="margin-top:12px">{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'customer', class: 'reveal', style: 'margin-top:26px' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'general.newsletter_form.success' | t }}</p>
      {%- else -%}
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
          <label class="visually-hidden" for="news-{{ section.id }}">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
          <input
            id="news-{{ section.id }}"
            class="input"
            type="email"
            name="contact[email]"
            required
            autocomplete="email"
            placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
            style="flex:1 1 260px;max-width:380px"
          >
          <button type="submit" class="btn btn--primary">{{ 'general.newsletter_form.submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors.messages['email'] }}</p>
        {%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "RESTEZ DANS LA BOUCLE" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#060606" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
