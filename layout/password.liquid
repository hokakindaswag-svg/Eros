<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}
    {{ content_for_header }}
    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
    -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      :root{
        --eros-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --eros-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      }
    </style>
    {{ 'eros-base.css' | asset_url | stylesheet_tag }}
    {{ 'eros-components.css' | asset_url | stylesheet_tag }}
    {{ 'eros-templates.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template--password">
    <main id="MainContent">{{ content_for_layout }}</main>
    <script src="{{ 'eros-theme.js' | asset_url }}" defer></script>
  </body>
</html>
