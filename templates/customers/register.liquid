<div class="auth page-width">
  <h1 class="auth__title">{{ 'customer.register.title' | t }}</h1>
  {% form 'create_customer', novalidate: 'novalidate' %}
    {{ form.errors | default_errors }}
    <div style="margin-top:26px">
      <div class="field"><input class="input" type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" autocomplete="given-name"></div>
      <div class="field"><input class="input" type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" autocomplete="family-name"></div>
      <div class="field"><input class="input" type="email" name="customer[email]" placeholder="{{ 'customer.register.email' | t }}" autocomplete="email" required></div>
      <div class="field"><input class="input" type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:14px">{{ 'customer.register.submit' | t }}</button>
    </div>
  {% endform %}
  <p class="auth__alt">
    {{ 'customer.register.has_account' | t }}
    <a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.register.sign_in' | t }}</a>
  </p>
</div>
