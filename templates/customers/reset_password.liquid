<div class="auth page-width">
  <h1 class="auth__title">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="t-body" style="text-align:center;margin-top:12px">{{ 'customer.reset_password.subtext' | t }}</p>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div style="margin-top:24px">
      <div class="field"><input class="input" type="password" name="customer[password]" placeholder="{{ 'customer.reset_password.password' | t }}"></div>
      <div class="field"><input class="input" type="password" name="customer[password_confirmation]" placeholder="{{ 'customer.reset_password.password_confirm' | t }}"></div>
      <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:14px">{{ 'customer.reset_password.submit' | t }}</button>
    </div>
  {% endform %}
</div>
