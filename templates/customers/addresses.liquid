<section class="page-hero">
  <div class="page-width"><h1 class="page-hero__title">{{ 'customer.addresses.title' | t }}</h1></div>
</section>
<section class="account">
  <div class="page-width">
    {% paginate customer.addresses by 10 %}
      <div style="max-width:520px">
        {% form 'customer_address', customer.new_address %}
          <h2 class="t-label" style="margin-bottom:16px">{{ 'customer.addresses.add_new' | t }}</h2>
          <div class="field"><input class="input" type="text" name="address[first_name]" placeholder="{{ 'customer.addresses.first_name' | t }}"></div>
          <div class="field"><input class="input" type="text" name="address[last_name]" placeholder="{{ 'customer.addresses.last_name' | t }}"></div>
          <div class="field"><input class="input" type="text" name="address[address1]" placeholder="{{ 'customer.addresses.address1' | t }}"></div>
          <div class="field"><input class="input" type="text" name="address[address2]" placeholder="{{ 'customer.addresses.address2' | t }}"></div>
          <div class="field"><input class="input" type="text" name="address[city]" placeholder="{{ 'customer.addresses.city' | t }}"></div>
          <div class="field"><input class="input" type="text" name="address[zip]" placeholder="{{ 'customer.addresses.zip' | t }}"></div>
          <div class="field">
            <select class="input" name="address[country]" data-default="{{ form.country }}">{{ country_option_tags }}</select>
          </div>
          <div class="field"><input class="input" type="tel" name="address[phone]" placeholder="{{ 'customer.addresses.phone' | t }}"></div>
          <button type="submit" class="btn btn--primary btn--full" style="margin-top:12px">{{ 'customer.addresses.add' | t }}</button>
        {% endform %}
      </div>

      <div style="margin-top:44px;display:grid;gap:18px">
        {%- for address in customer.addresses -%}
          <div style="border:1px solid var(--eros-line);padding:18px">
            <div class="t-body">{{ address | format_address }}</div>
            <div style="display:flex;gap:16px;margin-top:12px">
              <a href="{{ address.url }}" class="link-underline">{{ 'customer.addresses.edit' | t }}</a>
              <a href="{{ address.url }}" data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
                 class="link-underline"
                 onclick="if(confirm(this.dataset.confirmMessage)){Shopify.postLink(this.href,{parameters:{_method:'delete'}});}return false;">
                {{ 'customer.addresses.delete' | t }}
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {% endpaginate %}
    <p style="margin-top:30px"><a href="{{ routes.account_url }}" class="link-underline">{{ 'customer.account.return' | t }}</a></p>
  </div>
</section>
