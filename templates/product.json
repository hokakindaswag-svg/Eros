{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": { "note": "TAXES INCLUSES" } },
        "variants": { "type": "variants", "settings": { "size_guide_label": "GUIDE DES TAILLES" } },
        "buy": {
          "type": "buy",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true,
            "show_stock": true,
