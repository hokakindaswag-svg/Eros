            "promise_field_placeholder": "POUR QUI ? (OPTIONNEL)"
          }
        },
        "promise": { "type": "promise", "settings": {} },
        "accordions": {
          "type": "accordions",
          "settings": {
            "show_description": true,
            "description_title": "DESCRIPTION",
            "show_specs": true,
            "specs_title": "CARACTÉRISTIQUES",
            "title_1": "MATÉRIAU",
            "title_2": "ENTRETIEN",
            "title_3": "LIVRAISON",
            "title_4": "RETOURS"
          }
        }
      },
      "block_order": ["title", "price", "variants", "buy", "promise", "accordions"],
      "settings": {
        "gallery_columns": 2,
        "first_image_full": true,
        "sticky_atc": true,
        "update_url": true
      }
