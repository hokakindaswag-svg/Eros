<section class="section" style="--section-pt:90px;--section-pb:90px;min-height:100svh;display:grid;place-items:center">
  <div class="page-width" style="text-align:center;max-width:460px">
    <p class="hero-title chrome-text" style="font-size:clamp(34px,10vw,72px)">{{ settings.brand_name | default: shop.name }}</p>
    <p class="t-eyebrow" style="margin-top:18px">BIENTÔT</p>

    {% form 'storefront_password' %}
      <div style="margin-top:30px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
        <label class="visually-hidden" for="pw">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input id="pw" class="input" type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" style="flex:1 1 220px">
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_form_submit' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p class="form-error">{{ 'general.password_page.login_form_error' | t }}</p>
      {%- endif -%}
    {% endform %}

    <p class="t-body" style="margin-top:26px;font-size:var(--fs-xs)">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</section>
